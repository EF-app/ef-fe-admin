# axios baseURL — proxy 방식을 쓰면 비워둬야 /api 상대경로로 호출되어 vite proxy를 탑니다.
# 직접 호출(CORS 필요)로 바꾸려면 아래 줄의 주석을 풀고 절대 URL을 넣으세요.
# VITE_API_URL=http://192.168.219.100:8080

# vite dev 서버가 /api 요청을 forward할 백엔드 주소 (vite.config.ts에서 사용)
VITE_API_PROXY_TARGET=http://192.168.xxx.xxx:8080

# dev 모드에서 로그인 가드 우회 (true 일 때만 통과). 운영 빌드에서는 무조건 무시됨.
# npm run dev 면 import.meta.env.DEV 로 켜지고, 그런데 VITE_SKIP_AUTH = false로 변경하면 로그인 가드 동작.
# npm run build 면 import.meta.env.PROD로 켜짐.
VITE_SKIP_AUTH=true

# === Mock 모드 (단일 플래그) ===
# true  → BE 연결된 도메인(현재 auth + notice)도 강제 mock. 친구/팀원 데모용 (admin02/1234)
# false → BE 연결된 도메인만 BE 호출. 미연결 도메인은 훅이 항상 mock 반환.
#         BE 가 새 도메인을 구현하면 해당 훅의 short-circuit 한 줄을 isMockMode 분기로 복귀.
VITE_USE_MOCK=true